                jumpPowerLabel.Text = "قوة القفز: " .. jumpPower
            end
        end)

        RunService.Stepped:Connect(function()
            pcall(function()
                if character then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if noclipActive then
                                part.CanCollide = false
                            end
                        end
                    end
                end
                
                if flying and humanoidRootPart and bv and bg then
                    local camera = workspace.CurrentCamera
                    local inputDir = Vector3.new(0, 0, 0)
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then inputDir = inputDir + Vector3.new(0, 0, -1) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then inputDir = inputDir + Vector3.new(0, 0, 1) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then inputDir = inputDir + Vector3.new(-1, 0, 0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then inputDir = inputDir + Vector3.new(1, 0, 0) end
                    
                    local moveDirection = Vector3.new(0, 0, 0)
                    if inputDir.Magnitude == 0 and humanoid then
                        inputDir = humanoid.MoveDirection
                        if inputDir.Magnitude > 0 then
                            local camCF = camera.CFrame
                            local relDir = camCF:VectorToObjectSpace(inputDir)
                            moveDirection = (camCF.LookVector * -relDir.Z + camCF.RightVector * relDir.X)
                        end
                    else
                        moveDirection = (camera.CFrame.LookVector * -inputDir.Z + camera.CFrame.RightVector * inputDir.X)
                    end
                    
                    bv.Velocity = moveDirection * flySpeed
                    bg.CFrame = camera.CFrame
                end
            end)
        end)

    else
        VerifyButton.Text = "Incorrect Key! Try Again"
        VerifyButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
        task.wait(2)
        VerifyButton.Text = "Verify Key"
        VerifyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    end
end)